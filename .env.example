# ============================================================================
# Spring Car Rental API — required environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Loaded automatically via spring.config.import=optional:file:.env[.properties]
# ============================================================================

# ---- Database (MySQL) ----
# Host:port reachable from the backend. Local dev default; in Docker Compose
# this becomes the `mysql` service name (mysql:3306).
DB_HOST=localhost:3309
DB_USER=root
DB_PASS=your-strong-db-password

# ---- JWT ----
# Any string at least 32 bytes long. Generate with e.g.
#   openssl rand -base64 48
# Do NOT reuse the value from this example in production.
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
# Token lifetime in milliseconds (default 86400000 = 24h).
JWT_EXPIRE=86400000

# ---- SMTP (Gmail) ----
MAIL_USERNAME=your-email@gmail.com
# Gmail App Password (not your account password).
MAIL_PASSWORD=your-gmail-app-password

# ---- OAuth2 Login (Google / Facebook) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
# Frontend page the browser is redirected to after successful OAuth login
# (the backend receives the callback at /login/oauth2/code/{provider}).
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# ---- Cloudinary image hosting (used for /api/uploads) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---- Bakong (NBC KHQR payments) ----
BAKONG_ACCOUNT_ID=your-account@bkrt
BAKONG_BASE_URL=https://sit-api-bakong.nbc.gov.kh
EMAIL=your-email@gmail.com

# ---- CORS ----
# Comma-separated list of browser origins allowed to call this API.
# Default when unset: http://localhost:5173  (Vite dev server).
# For production set it to your real frontend domain, e.g.
#   APP_CORS_ALLOWED_ORIGINS=https://car-rental.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

#Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_PRIVATE_KEY=